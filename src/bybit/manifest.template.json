{
  "type": "bybit",
  "name": "Bybit",
  "version": "1.1.5-rc1",
  "description": "基于 V2.10.0 内置实现的兼容性修复候选；未签名，未发布。",
  "entrypoint": "adapter.py",
  "fields": [
    {
      "key": "api_key",
      "label": "API Key",
      "secret": false,
      "required": true,
      "placeholder": "Bybit API Key"
    },
    {
      "key": "api_secret",
      "label": "API Secret",
      "secret": true,
      "required": true,
      "placeholder": "Bybit API Secret"
    },
    {
      "key": "environment",
      "label": "账户环境",
      "kind": "select",
      "options": [
        [
          "live",
          "实盘"
        ],
        [
          "testnet",
          "Testnet"
        ],
        [
          "demo",
          "Demo 模拟"
        ]
      ],
      "default": "live"
    },
    {
      "key": "enable_spot",
      "label": "监听现货",
      "kind": "checkbox",
      "default": true
    },
    {
      "key": "enable_perpetual",
      "label": "监听 USDT 永续",
      "kind": "checkbox",
      "default": true
    }
  ],
  "files": {}
}
